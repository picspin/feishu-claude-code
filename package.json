{
  "name": "feishu-claude-code",
  "version": "0.1.0",
  "description": "Multi-channel IM bridge (Feishu / Telegram / WeCom) for local Claude Code, with Dardanus desktop pet",
  "license": "MIT",
  "keywords": ["feishu", "lark", "telegram", "wecom", "wechat", "claude-code", "agent-sdk", "bridge", "webhook", "dardanus"],
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/**/*.test.js",
    "postinstall": "npm run build",
    "start": "node dist/main.js start",
    "setup": "node dist/main.js setup",
    "daemon": "bash scripts/daemon.sh",
    "tunnel": "bash scripts/cloudflared-tunnel.sh",
    "setup-asr": "bash scripts/setup-asr.sh"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}

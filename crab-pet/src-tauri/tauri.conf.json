{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Feishu Crab Pet",
  "version": "0.1.0",
  "identifier": "com.feishu-claude-code.crab-pet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist-web"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Feishu Crab Pet",
        "label": "main",
        "width": 180,
        "height": 150,
        "decorations": false,
        "transparent": true,
        "backgroundColor": [0, 0, 0, 0],
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src http://127.0.0.1:8787; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png"]
  }
}
